# Settings for posting author reviews at /admin/reviews. See SETUP.md.
# Add these in your host's settings. For local testing, copy this file to .env.local.

# The password you'll use to sign in. Make it long and unique.
ADMIN_PASSWORD=

# A GitHub fine-grained access key with Contents read and write on this repo only.
# Leave empty for local testing: reviews then save to your local file instead.
GITHUB_TOKEN=

GITHUB_REPO=yhubhee/plotsplice
GITHUB_BRANCH=main
